# Contoh variabel environment untuk orchestration.
# JANGAN commit file .env yang sudah berisi nilai asli — .env sudah di-.gitignore.
#
# Orchestration membaca `.env` di ROOT project (satu tingkat di atas folder ini),
# yang sama dengan yang dipakai pipeline scraping. Jadi normalnya TIDAK ADA yang
# perlu ditambahkan: variabel PG_* di bawah sudah ada di sana.

# --- Opsi 1 (default): pakai ulang variabel yang sudah dipakai scraper --------
# Connection string dirakit otomatis dari kelimanya.
PG_USER=postgres
PG_PASSWORD=ganti-dengan-password
PG_HOST=10.100.14.216
PG_PORT=5432
PG_DB=kol

# --- Opsi 2: satu URL utuh, menimpa Opsi 1 kalau diisi -----------------------
# Berguna kalau orchestration perlu user database sendiri, mis. user read-write
# terbatas yang hanya boleh menulis ke schema `feature`.
# KOL_DB_URL=postgresql://user:password@host:5432/kol

# --- Riwayat run Dagster -----------------------------------------------------
# Set ke folder TETAP, kalau tidak riwayat run hilang tiap kali proses berhenti.
# DAGSTER_HOME=D:\intern\scrapper-project\orchestration\.dagster_home
