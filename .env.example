PG_USER=postgres
PG_PASSWORD=
PG_HOST=
PG_PORT=5432
PG_DB=kol

# Token dari https://console.apify.com/settings/integrations
APIFY_API_TOKEN=
APIFY_ACTOR_ID=apify/instagram-profile-scraper
# includeAboutSection hanya untuk akun Apify berbayar; biarkan false di plan FREE.
APIFY_INCLUDE_ABOUT_SECTION=false

# TikTok memakai token Apify yang sama, hanya actor dan opsinya berbeda.
TIKTOK_ACTOR_ID=clockworks/tiktok-scraper
# Wajib diisi; tanpa residential proxy TikTok memblokir hampir semua request.
TIKTOK_PROXY_COUNTRY=ID
# Video per profil. 1 sudah cukup karena data profil ada di authorMeta tiap video.
TIKTOK_RESULTS_PER_PAGE=1

OUTPUT_DIR=output
