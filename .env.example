PG_USER=postgres
PG_PASSWORD=
PG_HOST=
PG_PORT=5432
PG_DB=kol

# Token dari https://console.apify.com/settings/integrations
APIFY_API_TOKEN=
APIFY_ACTOR_ID=apify/instagram-profile-scraper
# includeAboutSection hanya untuk akun Apify berbayar; biarkan false di plan FREE.
APIFY_INCLUDE_ABOUT_SECTION=false

# TikTok memakai token Apify yang sama, hanya actor dan opsinya berbeda.
TIKTOK_ACTOR_ID=clockworks/tiktok-scraper
# Wajib diisi; tanpa residential proxy TikTok memblokir hampir semua request.
TIKTOK_PROXY_COUNTRY=ID
# Video per profil. 1 sudah cukup karena data profil ada di authorMeta tiap video.
TIKTOK_RESULTS_PER_PAGE=1

OUTPUT_DIR=output

# --- Actor follower ---------------------------------------------------------
# Dibaca scrape_followers.py lewat --ig-actor/--tt-actor. Kalau kosong, dipakai
# konstanta bawaan di apify_followers.py (nilai di bawah ini sama persis dengan
# bawaan itu) -- jadi mengisinya hanya perlu kalau ingin mengganti actor tanpa
# menyentuh kode.
IG_FOLLOWERS_ACTOR_ID=apify/instagram-followers-following-scraper
TT_FOLLOWERS_ACTOR_ID=clockworks/tiktok-followers-scraper

# --- Plafon biaya Apify -----------------------------------------------------
# BUDGET PRODUKSI BELUM DITENTUKAN. Nilai di bawah ini seukuran UJI, dipasang
# supaya "lupa menyetel" berakhir sebagai run kecil yang tertahan plafon,
# bukan sebagai tagihan. Naikkan secara sadar setelah budget diputuskan.
#
# Flag --max-cost-usd / --max-charge-usd per pemanggilan SELALU menang atas
# nilai di sini.
SCRAPE_MAX_COST_PROFILE_USD=1.00
SCRAPE_MAX_COST_POST_USD=1.00
SCRAPE_MAX_COST_FOLLOWERS_USD=1.00

# Harga per follower untuk ESTIMASI sebelum run (bukan tarif yang ditagih).
# Default 0.0013 berasal dari biaya nyata yang tercatat di
# docs/PIPELINE_STATUS.md: $3,01 untuk 2.300 follower.
PRICE_PER_FOLLOWER_USD=0.0013
